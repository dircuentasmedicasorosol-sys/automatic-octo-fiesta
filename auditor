    function duracionTrayecto(origen, destino) {
      const o = normalizar(origen), d = normalizar(destino);
      if (!o || !d) return null;
      if (o === d) return 30;
      if (duracionesRutas[o + '>' + d] != null) return duracionesRutas[o + '>' + d];
      if (duracionesRutas[d + '>' + o] != null) return duracionesRutas[d + '>' + o];
      const vecinas = Object.keys(duracionesRutas).filter(k => {
        const p = k.split('>');
        return p[0] === o || p[1] === d;
      });
      if (vecinas.length === 0) return null;
      const media = vecinas.reduce((s, k) => s + duracionesRutas[k], 0) / vecinas.length;
      return Math.round(media / 15) * 15;
    }

    // Devuelve la hora (HH:MM:SS) a la que aproximadamente termina el servicio.
    function llegadaAproximada(horaRecogida, origen, destino) {
      const base = mins(horaRecogida);
      const minutos = duracionTrayecto(origen, destino);
      if (base == null || minutos == null) return '';
      const t = (base + minutos) % 1440;
      return String(Math.floor(t / 60)).padStart(2, '0') + ':' + String(t % 60).padStart(2, '0') + ':00';
    }

    function agregarPacienteExclusivo() {
      const input = document.getElementById('inputPacienteExclusivo');
      const val = input.value.trim();
      if (!val) return;

      if (!pacientesExclusivos.includes(val.toUpperCase())) {
        pacientesExclusivos.push(val.toUpperCase());
        actualizarTagsExclusivos();
        input.value = '';

        if (datosUltimoExcel) {
          evaluarReglas(datosUltimoExcel.servicios, datosUltimoExcel.flota);
        }
      }
    }

    function eliminarPacienteExclusivo(nombre) {
      pacientesExclusivos = pacientesExclusivos.filter(item => item !== nombre);
      actualizarTagsExclusivos();
      if (datosUltimoExcel) {
        evaluarReglas(datosUltimoExcel.servicios, datosUltimoExcel.flota);
      }
    }

    function actualizarTagsExclusivos() {
      const contenedor = document.getElementById('listaExclusivos');
      contenedor.innerHTML = '';

      if (pacientesExclusivos.length === 0) {
        contenedor.innerHTML = '<span style="font-size: 0.85rem; color: #64748b; font-style: italic;">Sin restricciones de exclusividad activas.</span>';
        return;

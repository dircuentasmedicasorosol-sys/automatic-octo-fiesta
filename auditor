        tag.innerHTML = `${nombre} <button onclick="eliminarPacienteExclusivo('${nombre}')">&times;</button>`;
        contenedor.appendChild(tag);
      });
    }

    function mins(horaStr) {
      if (!horaStr) return null;
      const partes = String(horaStr).split(':');
      if (partes.length < 2) return null;
      const h = parseInt(partes[0], 10);
      const m = parseInt(partes[1], 10);
      if (isNaN(h) || isNaN(m)) return null;
      return h * 60 + m;
    }

    // Convierte la fecha a texto legible (soporta número de serie de Excel, Date o texto)
    function formatearFecha(valor) {
      if (valor == null || valor === '') return '';
      if (valor instanceof Date && !isNaN(valor.getTime())) {
        return valor.toLocaleDateString('es-CO');
      }
      const s = String(valor).trim();
      if (/^\d{5}(\.\d+)?$/.test(s)) {
        const d = new Date(Date.UTC(1899, 11, 30) + parseFloat(s) * 86400000);
        if (!isNaN(d.getTime())) return d.toLocaleDateString('es-CO', { timeZone: 'UTC' });
      }
      return s;
    }

    // Los móviles son texto de 4 dígitos ("0701", "2713"). Se comparan como texto
    // igualado a 4 posiciones para que 0701 vaya antes que 0702.
    function compararMoviles(a, b) {
      const pa = String(a || '').trim().padStart(4, '0');
      const pb = String(b || '').trim().padStart(4, '0');
      if (pa === pb) return 0;
      return pa < pb ? -1 : 1;
    }

    // "14/10/2026" -> 20261014 y "2026-10-14" -> 20261014 para poder ordenar.
    // Excel entrega la fecha en formato ISO y la hoja coordinacion la muestra en
    // español; si el texto no tiene ninguno de los dos formatos devuelve null y el
    // orden original se mantiene.
    function claveFecha(fechaTexto) {
      const s = String(fechaTexto || '').trim();
      const iso = /^(\d{4})-(\d{1,2})-(\d{1,2})/.exec(s);
      if (iso) return (+iso[1]) * 10000 + (+iso[2]) * 100 + (+iso[3]);
      const partes = s.split('/');
      if (partes.length !== 3) return null;
      const dia = parseInt(partes[0], 10);
      const mes = parseInt(partes[1], 10);
      const anio = parseInt(partes[2], 10);
      if (isNaN(dia) || isNaN(mes) || isNaN(anio)) return null;
      return anio * 10000 + mes * 100 + dia;
    }

    function buscarColumna(objeto, nombresPosibles) {
      const llaves = Object.keys(objeto);
      for (let llave of llaves) {
        const norm = normalizar(llave);
        for (let posible of nombresPosibles) {
          if (norm.includes(normalizar(posible))) {
            return objeto[llave];
          }
        }
      }
      return '';
    }

    // Busca una columna por su nombre EXACTO (sin acentos, sin mayúsculas) y solo si
    // no existe recurre al busca-por-contenido de arriba. Hace falta porque el archivo
    // de Traslados trae columnas "Origen" y "Destino" antes de "Ciudad Origen" y
    // "Ciudad Destino", y esas traen "Domicilio" o el nombre de la clínica, no el municipio.
    function columnaPorNombre(objeto, nombresPosibles) {
      const llaves = Object.keys(objeto);
      for (let posible of nombresPosibles) {
        const buscado = normalizar(posible);
        const exacta = llaves.find(llave => normalizar(llave) === buscado);
        if (exacta !== undefined) return objeto[exacta];
      }
      return buscarColumna(objeto, nombresPosibles);
    }

    function esRecogidaEnCorredorValida(orig1, dest1, orig2, dest2) {
      const o1 = normalizar(orig1);
      const d1 = normalizar(dest1);
      const o2 = normalizar(orig2);
      const d2 = normalizar(dest2);

      for (let corredor of corredoresViales) {
        const idxO1 = corredor.indexOf(o1);
        const idxO2 = corredor.indexOf(o2);
        const idxD1 = corredor.indexOf(d1);
        const idxD2 = corredor.indexOf(d2);

        if (idxO1 !== -1 && idxO2 !== -1 && idxD1 !== -1 && idxD2 !== -1) {
          if (idxO1 <= idxD1 && idxO2 <= idxD2) {
            if (idxO1 <= idxO2) return true;
          } else if (idxO1 >= idxD1 && idxO2 >= idxD2) {
            if (idxO1 >= idxO2) return true;
          }
        }
      }
      return false;
    }

    // Elige las hojas por lo que contienen, no por el orden en el Excel:
    // "coordinacion" + "carros" en la Asignación de móviles, y una sola hoja
    // "Traslados" (que no trae flota) en el export diario de traslados.
    function elegirHojas(hojas) {
      const traeColumna = (hoja, nombres) => Object.keys(hoja.filas[0]).some(llave =>
        nombres.some(posible => normalizar(llave).includes(normalizar(posible))));

      const hojaServicios = hojas.find(h =>
        traeColumna(h, ['Paciente']) && traeColumna(h, ['Vehiculo', 'Movil', 'Carro']));
      const hojaFlota = hojas.find(h => h !== hojaServicios &&
        traeColumna(h, ['Vehiculo', 'Movil', 'Carro']) && traeColumna(h, ['Zona']));

      return { hojaServicios, hojaFlota };
    }

    // Las columnas que se leen del Excel. En la Asignación de móviles son Fecha, Paciente,
    // Vehiculo, Hora Recogida, Ciudad Origen y Ciudad Destino; en Traslados son B, E, I, C,
    // AC y AG, más D (Estado). Documento (F) está pero ninguna regla la usa. La hora de llegada
    // NO se lee: se estima con duracionTrayecto, así que la columna AA se ignora como las demás.
    function mapearServicios(filasRaw) {
      return filasRaw.map(s => {
        const servicio = {
          Vehiculo: String(columnaPorNombre(s, ['Vehiculo', 'Movil', 'Carro'])).trim(),
          Fecha: String(columnaPorNombre(s, ['Fecha'])).trim(),
          Estado: String(columnaPorNombre(s, ['Estado'])).trim(),
          HoraRecogida: columnaPorNombre(s, ['Hora Recogida', 'Hora_Recogida', 'Recogida', 'Hora']),
          CiudadOrigen: String(columnaPorNombre(s, ['Ciudad Origen', 'Ciudad_Origen', 'Origen'])).trim(),
          CiudadDestino: String(columnaPorNombre(s, ['Ciudad Destino', 'Ciudad_Destino', 'Destino'])).trim(),
          Paciente: String(columnaPorNombre(s, ['Paciente', 'Usuario', 'Pasajero', 'Cliente'])).trim(),
          HoraLlegada: llegadaAproximada(
            columnaPorNombre(s, ['Hora Recogida', 'Hora_Recogida', 'Recogida', 'Hora']),
            columnaPorNombre(s, ['Ciudad Origen', 'Ciudad_Origen', 'Origen']),
            columnaPorNombre(s, ['Ciudad Destino', 'Ciudad_Destino', 'Destino']))
        };
        return servicio;
      });
    }

    function mapearFlota(filasRaw) {
      return filasRaw.map(c => ({
        vehiculo: String(columnaPorNombre(c, ['Vehiculo', 'Movil', 'Carro'])).trim(),
        BASE: String(columnaPorNombre(c, ['Ciudad', 'Base'])).trim(),
        ZONA: String(columnaPorNombre(c, ['Zona'])).trim()
      }));
    }

    function procesarArchivo(event) {
      const file = event.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(e) {
        try {
          const data = new Uint8Array(e.target.result);
          const workbook = XLSX.read(data, { type: 'array', cellDates: true });

          const nombresHojas = workbook.SheetNames;
          if (nombresHojas.length === 0) {
            alert("El archivo Excel no contiene hojas.");
            return;
          }

          const hojas = nombresHojas.map(nombre => ({
            nombre,
            filas: XLSX.utils.sheet_to_json(workbook.Sheets[nombre], { raw: false })
          })).filter(h => h.filas.length > 0);

          const hojaElegida = elegirHojas(hojas);
          if (!hojaElegida.hojaServicios) {
            alert("El archivo no tiene una hoja de servicios con columnas Paciente y Vehículo.");
            return;
          }

          const filasServicios = hojaElegida.hojaServicios.filas;
          const todos = mapearServicios(filasServicios);
          // La hoja "coordinacion" de la Asignación de móviles no trae columna Estado: ahí no se
          // puede excluir nada y el KPI lo dice en vez de mostrar un 0 que parece un filtro aplicado.
          canceladosExcluidos = {
            traeColumna: Object.keys(filasServicios[0] || {}).some(llave => normalizar(llave) === 'ESTADO'),
            cantidad: todos.filter(s => estaCancelado(s.Estado)).length
          };
          const servicios = todos.filter(s => !estaCancelado(s.Estado));
          const flota = mapearFlota(hojaElegida.hojaFlota ? hojaElegida.hojaFlota.filas : []);

          datosUltimoExcel = { servicios, flota };
          evaluarReglas(servicios, flota);
        } catch (err) {
          alert("Error al procesar el Excel: " + err.message);
        }
      };

      reader.readAsArrayBuffer(file);
    }

    // Ocupación simultánea REAL de pasajeros (barrido de intervalos).
    // Devuelve el pico máximo de personas a bordo a la vez y sus nombres.
    function momentosABordo(lista) {
      return lista.map((s, idx) => {
        const r = mins(s.HoraRecogida);
        let l = mins(s.HoraLlegada);
        if (r == null || l == null || l <= r) return null;

        // El pasajero deja el vehículo cuando el móvil lo deja en su pueblo destino,
        // aunque su llegada estimada sea más tarde: si ahí mismo sube otro pasajero,
        // el desembarco ocurrió antes de esa recogida. Sin esto, una cadena
        // Ibagué→Espinal + Espinal→Purificación cuenta como 2 a bordo cuando es 1.
        const destino = normalizar(s.CiudadDestino);
        if (destino) {
          lista.forEach((otro, j) => {
            if (j === idx) return;
            const ro = mins(otro.HoraRecogida);
            if (ro != null && ro > r && ro < l && normalizar(otro.CiudadOrigen) === destino) l = ro;
          });
        }
        return [r, l];
      });
    }

    function ocupacionPico(lista) {
      const eventos = [];
      momentosABordo(lista).forEach((intervalo, idx) => {
        if (!intervalo) return;
        eventos.push([intervalo[0], 1, idx]);
        eventos.push([intervalo[1], -1, idx]);
      });
      eventos.sort((a, b) => a[0] - b[0] || a[1] - b[1]);
      const aBordo = new Set();
      let pico = 0;
      let conjuntoPico = new Set();
      eventos.forEach(e => {
        if (e[1] > 0) aBordo.add(e[2]); else aBordo.delete(e[2]);
        // Una persona no ocupa dos asientos. Cuando el mismo paciente tiene dos filas
        // que se solapan (el Excel duplica la solicitud, como los CS 1533908 y 1502182
        // de Martinez Maldonado en el móvil 0773) cuenta una sola vez.
        const pasajeros = new Set([...aBordo].map(i => normalizar(lista[i].Paciente)));
        if (pasajeros.size > pico) { pico = pasajeros.size; conjuntoPico = new Set(aBordo); }
      });
      return { pico, nombres: [...new Set([...conjuntoPico].map(i => lista[i].Paciente))] };
    }

    // Compara normalizando acentos y mayúsculas (corrige nombres con Ñ/tilde).
    function esPacienteExclusivo(nombre) {
      const n = normalizar(nombre);
      if (!n) return false;
      return pacientesExclusivos.some(ex => n.includes(normalizar(ex)));
    }

    function evaluarReglas(servicios, flota) {
      hallazgosGlobales = [];

      const mapaFlota = {};
      flota.forEach(c => {
        if (!c.vehiculo) return;
        const base = (c.BASE || c.ZONA || '').trim();
        // La zona asignada manda desde la columna ZONA; si viene vacía o no es una
        // zona válida, se deriva de la ciudad base como respaldo.
        let zonaAsignada = ['NORTE', 'CENTRO', 'SUR'].includes(normalizar(c.ZONA))
          ? normalizar(c.ZONA)
          : obtenerZonaMunicipio(base);
        mapaFlota[c.vehiculo] = { BASE: base, ZONA: (c.ZONA || '').trim(), zonaAsignada };
      });

      const agrupados = {};
      servicios.forEach(s => {
        if (!s.Vehiculo || !s.Fecha) return;
        const key = `${s.Vehiculo}_${s.Fecha}`;
        if (!agrupados[key]) agrupados[key] = [];
        agrupados[key].push(s);
      });

      let conteoConflictos = 0;
      let conteoUsuariosCompartidos = 0;
      let conteoExclusivosCompartidos = 0;
      let conteoInconsistenciasZona = 0;
      let conteoVacio = 0;
      let conteoSinFlota = 0;
      const vehiculosSinFlota = new Set();
      const hayFlota = flota.length > 0;
      const movilesConServicios = new Set();

      Object.keys(agrupados).forEach(key => {
        const lista = agrupados[key].slice().sort((a, b) =>
          (mins(a.HoraRecogida) ?? Number.MAX_SAFE_INTEGER) - (mins(b.HoraRecogida) ?? Number.MAX_SAFE_INTEGER));

        const vehId = lista[0].Vehiculo;
        movilesConServicios.add(vehId);
        const vehInfo = mapaFlota[vehId];
        const primerServicio = lista[0];
        const ultimoServicio = lista[lista.length - 1];

        // MÓVIL SIN REGISTRO EN FLOTA
        // Solo cuando el archivo trae hoja de flota: un móvil que aparece en el
        // listado es inevitablemente "desconocido" si no se cargó ninguna flota.
        if (hayFlota && !vehInfo && !vehiculosSinFlota.has(vehId)) {
          vehiculosSinFlota.add(vehId);
          conteoSinFlota++;
          hallazgosGlobales.push({
            categoria: 'SIN_FLOTA',
            tipo: 'ALERTA: Móvil no registrado en la flota',
            vehiculo: vehId,
            fecha: formatearFecha(primerServicio.Fecha),
            detalle: `Regla: todo móvil con servicios debe aparecer en la hoja "carros". El Móvil <b>${vehId}</b> tiene servicios asignados pero no está registrado en la flota, por eso no se puede validar su zona ni su base.`
          });
        }

        // VALIDACIÓN DE ZONAS (Norte, Centro, Sur)
        if (vehInfo && vehInfo.zonaAsignada) {
          const zonaInicioReal = obtenerZonaMunicipio(primerServicio.CiudadOrigen);
          const zonaFinReal = obtenerZonaMunicipio(ultimoServicio.CiudadDestino);
          let detallesZona = [];

          if (zonaInicioReal && zonaInicioReal !== vehInfo.zonaAsignada) {
            detallesZona.push(`empezó el día en <b>${primerServicio.CiudadOrigen}</b>, que es zona ${zonaInicioReal}`);
          }
          if (zonaFinReal && zonaFinReal !== vehInfo.zonaAsignada) {
            detallesZona.push(`terminó el día en <b>${ultimoServicio.CiudadDestino}</b>, que es zona ${zonaFinReal}`);
          }

          if (detallesZona.length > 0) {
            conteoInconsistenciasZona++;
            hallazgosGlobales.push({
              categoria: 'ZONA_INCOMPATIBLE',
              tipo: 'ALERTA: Trabajó fuera de su zona asignada',
              vehiculo: vehId,
              fecha: formatearFecha(primerServicio.Fecha),
              detalle: `Regla: cada móvil debe operar solo en su zona asignada. Este móvil está asignado a la zona <b>${vehInfo.zonaAsignada}</b> (base ${vehInfo.BASE}), pero ${detallesZona.join(' y ')}.`
            });
          }
        }

        // CAPACIDAD MÁXIMA: ocupación simultánea real (una sola alerta por móvil/día)
        const ocupacion = ocupacionPico(lista);
        if (ocupacion.pico > 2) {
          conteoConflictos++;
          hallazgosGlobales.push({
            categoria: 'CRITICO',
            tipo: 'CRÍTICO: Más de 2 pasajeros a la vez',
            vehiculo: vehId,
            fecha: formatearFecha(primerServicio.Fecha),
            detalle: `Regla: máximo 2 pasajeros a bordo al mismo tiempo. Este móvil llegó a llevar <b>${ocupacion.pico} pasajeros simultáneos</b>: ${ocupacion.nombres.join(', ')}.`
          });
        }

        // COMPARTIDOS Y EXCLUSIVIDAD (solapamiento temporal real entre servicios)
        lista.forEach(actual => {
          const ra = mins(actual.HoraRecogida);
          const la = mins(actual.HoraLlegada);
          if (ra == null || la == null) return;

          const companeros = lista.filter(otro => {
            if (otro === actual) return false;
            const rb = mins(otro.HoraRecogida);
            const lb = mins(otro.HoraLlegada);
            if (rb == null || lb == null) return false;
            return rb < la && lb > ra;
          });

          if (companeros.length > 0) conteoUsuariosCompartidos++;

          const actualEsExclusivo = esPacienteExclusivo(actual.Paciente);
          const companeroExclusivo = companeros.find(o => esPacienteExclusivo(o.Paciente));

          if (companeros.length > 0 && (actualEsExclusivo || companeroExclusivo)) {
            const nombreExclusivo = actualEsExclusivo ? actual.Paciente : companeroExclusivo.Paciente;
            const otros = actualEsExclusivo ? companeros.map(c => c.Paciente).join(', ') : actual.Paciente;
            conteoExclusivosCompartidos++;
            hallazgosGlobales.push({
              categoria: 'EXCLUSIVO_COMPARTIDO',
              tipo: 'ALERTA: Paciente exclusivo viajó acompañado',
              vehiculo: vehId,
              fecha: formatearFecha(actual.Fecha),
              detalle: `Regla: los pacientes exclusivos NO pueden compartir vehículo. <b>${nombreExclusivo}</b> es exclusivo y viajó en el Móvil ${vehId} acompañado de <b>${otros}</b>.`
            });
          }
        });

        // ANÁLISIS SECUENCIAL: multirecogida, ruta intermedia, solapamiento y vacío
        // El móvil queda en el pueblo donde DEJÓ al último pasajero, y eso se mide en el
        // momento real del desembarco, no en la llegada estimada del servicio: en una
        // cadena Ibagué→Espinal + Espinal→Purificación el segundo viaje termina antes en
        // el reloj aunque su llegada estimada sea mayor.
        const finesABordo = momentosABordo(lista);
        for (let i = 1; i < lista.length; i++) {
          const actual = lista[i];
          const previo = lista[i - 1];

          const minsRecogidaActual = mins(actual.HoraRecogida);
          const minsLlegadaPrevio = mins(previo.HoraLlegada);
          const minsRecogidaPrevio = mins(previo.HoraRecogida);
          if (minsRecogidaActual == null || minsLlegadaPrevio == null || minsRecogidaPrevio == null) continue;

          const origPrev = normalizar(previo.CiudadOrigen);
          const destPrev = normalizar(previo.CiudadDestino);
          const origAct = normalizar(actual.CiudadOrigen);
          const destAct = normalizar(actual.CiudadDestino);
          const diffRecogidas = minsRecogidaActual - minsRecogidaPrevio;

          // DOBLE ASIGNACIÓN: dos servicios que inician a la misma hora en puntos distintos
          if (diffRecogidas === 0 && origPrev !== origAct) {
            conteoConflictos++;
            hallazgosGlobales.push({
              categoria: 'CRITICO',
              tipo: 'CRÍTICO: Dos recogidas a la misma hora en pueblos distintos',
              vehiculo: vehId,
              fecha: formatearFecha(actual.Fecha),
              detalle: `Regla: un móvil no puede estar en dos lugares a la vez. Tiene dos servicios que <b>arrancan a la misma hora (${actual.HoraRecogida})</b>: uno en <b>${previo.CiudadOrigen}</b> (${previo.Paciente}) y otro en <b>${actual.CiudadOrigen}</b> (${actual.Paciente}).`
            });
            continue;
          }

          // RECOGIDA EN LA MISMA CIUDAD CON LÍMITE DE 30 MIN
          if (origPrev === origAct) {
            if (diffRecogidas >= 0 && diffRecogidas <= 30) {
              continue;
            } else if (diffRecogidas > 30 && minsRecogidaActual < minsLlegadaPrevio) {
              conteoConflictos++;
              hallazgosGlobales.push({
                categoria: 'CRITICO',
                tipo: 'CRÍTICO: Espera de más de 30 min entre recogidas del mismo pueblo',
                vehiculo: vehId,
                fecha: formatearFecha(actual.Fecha),
                detalle: `Regla: entre dos recogidas en el mismo pueblo deben pasar máximo 30 min. Aquí pasaron <b>${diffRecogidas} min</b> en ${actual.CiudadOrigen} (${previo.Paciente} ${previo.HoraRecogida} y ${actual.Paciente} ${actual.HoraRecogida}).`
              });
              continue;
            }
          }

          // RECOGIDAS INTERMEDIAS EN DIFERENTES CIUDADES DEL CORREDOR VIAL
          if (minsRecogidaActual < minsLlegadaPrevio) {
            if (origPrev !== origAct && esRecogidaEnCorredorValida(origPrev, destPrev, origAct, destAct)) {
              continue;
            } else if (origAct !== origPrev || destAct !== destPrev) {
              conteoConflictos++;
              hallazgosGlobales.push({
                categoria: 'CRITICO',
                tipo: 'CRÍTICO: Horarios cruzados sin corredor compartido',
                vehiculo: vehId,
                fecha: formatearFecha(actual.Fecha),
                detalle: `Regla: si un servicio arranca antes de que termine el anterior, debe ser una recogida de paso del mismo corredor. Aquí el servicio de <b>${actual.Paciente}</b> (${actual.HoraRecogida}) arranca cuando el de <b>${previo.Paciente}</b> aún no termina (llegada estimada ~${previo.HoraLlegada}) y no comparten corredor.`
              });
            }
          }

          // DÓNDE QUEDÓ EL MÓVIL ANTES DE ESTA RECOGIDA
          // Es el destino del servicio cuyo desembarco fue el último en el reloj. No se
          // usa la llegada estimada cruda porque en una cadena de paradas el viaje más
          // largo puede haber soltado a su pasajero antes, en el mismo pueblo donde otro
          // sube.
          const finalizadosAntes = [];
          for (let j = 0; j < i; j++) {
            if (finesABordo[j] && finesABordo[j][1] <= minsRecogidaActual) finalizadosAntes.push(j);
          }

          if (finalizadosAntes.length === 0) continue;

          const finMaximo = Math.max(...finalizadosAntes.map(j => finesABordo[j][1]));
          const empatados = finalizadosAntes.filter(j => finesABordo[j][1] === finMaximo);

          // Dos servicios que terminan a la misma hora en pueblos distintos no pueden ser
          // los dos: el móvil hizo una sola cadena de paradas. El último destino es el que
          // queda más lejos del pueblo donde embarcó el primero de los dos, porque el otro
          // quedó de paso en ese mismo camino.
          let idxUltimoTerminado = empatados[0];
          if (empatados.length > 1) {
            const origenCadena = normalizar(lista[empatados[0]].CiudadOrigen);
            let maxDistancia = -1;
            empatados.forEach(j => {
              const destino = normalizar(lista[j].CiudadDestino);
              corredoresViales.forEach(corredor => {
                const io = corredor.indexOf(origenCadena);
                const jd = corredor.indexOf(destino);
                if (io === -1 || jd === -1) return;
                if (Math.abs(jd - io) > maxDistancia) {
                  maxDistancia = Math.abs(jd - io);
                  idxUltimoTerminado = j;
                }
              });
            });
          }
          const ultimoTerminado = lista[idxUltimoTerminado];
          const minsFinUltimo = finesABordo[idxUltimoTerminado][1];
          const horaFinUltimo = String(Math.floor(minsFinUltimo / 60)).padStart(2, '0') + ':' +
            String(minsFinUltimo % 60).padStart(2, '0');

          const origPosicion = normalizar(ultimoTerminado.CiudadDestino);
          const minsTraslado = minsRecogidaActual - minsFinUltimo;

          // Si hay un servicio que ya iba en curso y arrancó en este mismo pueblo, el
          // móvil ya está aquí: la recogida de paso se valida más arriba. Solo cuenta lo
          // que empezó ANTES, porque otro servicio que arranca a esta misma hora en el
          // mismo pueblo es precisamente lo que se está auditando.
          const yaEstaEnElPueblo = lista.some(o => o !== actual &&
            mins(o.HoraRecogida) != null && mins(o.HoraLlegada) != null &&
            mins(o.HoraRecogida) < minsRecogidaActual && minsRecogidaActual < mins(o.HoraLlegada) &&
            normalizar(o.CiudadOrigen) === origAct);

          if (origPosicion !== origAct && minsTraslado <= 0) {
            // Cero minutos de traslado: aunque los dos pueblos estén en el mismo
            // corredor, el móvil no puede dejar a un pasajero y recoger a otro
            // en otro pueblo en la misma hora.
            conteoConflictos++;
            hallazgosGlobales.push({
              categoria: 'CRITICO',
              tipo: 'CRÍTICO: Sin tiempo de traslado entre servicios',
              vehiculo: vehId,
              fecha: formatearFecha(actual.Fecha),
              detalle: `Regla: el móvil debe terminar un servicio y tener tiempo de llegar al punto de la siguiente recogida. Dejó a ${ultimoTerminado.Paciente} en <b>${ultimoTerminado.CiudadDestino}</b> a las ~${horaFinUltimo} (hora estimada) y a <b>la misma hora</b> debe recoger a ${actual.Paciente} en <b>${actual.CiudadOrigen}</b>: no tiene ni un minuto de traslado.`
            });
          } else if (origPosicion !== origAct && !yaEstaEnElPueblo) {
            // Los minutos libres solo sirven si alcanzan para el trayecto real entre los
            // dos pueblos. Si no alcanzan, esto no es un vacío: es un servicio que no se
            // puede cumplir a la hora asignada.
            // Se usa SOLO la duración observada en el histórico (no el promedio
            // aproximado de rutas vecinas) para no declarar crítico un salto entre
            // pueblos vecinos del que no hay dato. El pronóstico de llegada sigue
            // usando duracionTrayecto con su aproximación, sin cambios.
            const minsTrayectoNecesario = (origPosicion !== origAct && origPosicion && origAct)
              ? (duracionesRutas[origPosicion + '>' + origAct] ?? duracionesRutas[origAct + '>' + origPosicion])
              : null;

            if (minsTrayectoNecesario != null && minsTraslado < minsTrayectoNecesario) {
              const minsTarde = minsTrayectoNecesario - minsTraslado;
              const horaTarde = (minsRecogidaActual + minsTarde) % 1440;
              conteoConflictos++;
              hallazgosGlobales.push({
                categoria: 'CRITICO',
                tipo: 'CRÍTICO: No alcanza el traslado entre servicios',
                vehiculo: vehId,
                fecha: formatearFecha(actual.Fecha),
                detalle: `Regla: el móvil debe alcanzar a ir del punto donde terminó al punto de la siguiente recogida. Dejó a ${ultimoTerminado.Paciente} en <b>${ultimoTerminado.CiudadDestino}</b> a las ~${horaFinUltimo} (hora estimada) y debe recoger a ${actual.Paciente} en <b>${actual.CiudadOrigen}</b> a las ${actual.HoraRecogida}: tiene <b>${minsTraslado} min</b> pero el trayecto <b>${ultimoTerminado.CiudadDestino} → ${actual.CiudadOrigen}</b> toma ~${minsTrayectoNecesario} min. Los tiempos no dan: o <b>llega ~${minsTarde} min tarde</b> (a las ~${String(Math.floor(horaTarde / 60)).padStart(2, '0')}:${String(horaTarde % 60).padStart(2, '0')}) y deja esperando a ${actual.Paciente}, o <b>deja esperando al usuario del servicio anterior</b> para alcanzar a salir antes.`
              });

              // El crítico anterior no borra el vacío: el móvil igual recorre ese tramo
              // sin pasajeros, con tiempo de sobra o sin él. Son dos hallazgos distintos
              // y pasan a la vez.
              conteoVacio++;
              hallazgosGlobales.push({
                categoria: 'ADVERTENCIA',
                tipo: 'ADVERTENCIA: Se movió sin pasajeros entre servicios',
                vehiculo: vehId,
                fecha: formatearFecha(actual.Fecha),
                detalle: `Regla: evitar desplazamientos sin pasajeros. El móvil dejó a ${ultimoTerminado.Paciente} en <b>${ultimoTerminado.CiudadDestino}</b> a las ~${horaFinUltimo} (hora estimada) y tuvo que ir vacío hasta <b>${actual.CiudadOrigen}</b> para recoger a ${actual.Paciente} a las ${actual.HoraRecogida} (${minsTraslado} min de traslado).`
              });
            } else {
              // Terminado el servicio anterior, el móvil está libre: todo recorrido hasta
              // la siguiente recogida es sin pasajeros, esté o no en el mismo corredor.
              conteoVacio++;
              hallazgosGlobales.push({
                categoria: 'ADVERTENCIA',
                tipo: 'ADVERTENCIA: Se movió sin pasajeros entre servicios',
                vehiculo: vehId,
                fecha: formatearFecha(actual.Fecha),
                detalle: `Regla: evitar desplazamientos sin pasajeros. El móvil dejó a ${ultimoTerminado.Paciente} en <b>${ultimoTerminado.CiudadDestino}</b> a las ~${horaFinUltimo} (hora estimada) y tuvo que ir vacío hasta <b>${actual.CiudadOrigen}</b> para recoger a ${actual.Paciente} a las ${actual.HoraRecogida} (${minsTraslado} min de traslado).`
              });
            }
          }
        }

        // CASO ESPECIAL: el mismo momento admite dos lecturas y las dos son válidas.
        // No se elige ninguna ni se cambia el resto del reporte: solo se marca para
        // revisar el móvil a mano en el Excel.
        const confusos = [];
        lista.forEach((s, idxS) => {
          const r = mins(s.HoraRecogida);
          if (r == null || !s.CiudadOrigen) return;

          // Lectura 1: recogida de paso de un servicio que todavía va en curso y que
          // llegó de OTRO pueblo. Si ese servicio también sale de este mismo pueblo, las
          // dos lecturas dicen lo mismo y no hay nada ambiguo. Tampoco hay recogida "de
          // paso" si este pueblo es el destino de ese servicio: ahí el recorrido ya
          // terminó y el móvil quedó libre, no está de paso (móvil 0711: Fresno→Ibagué y
          // la recogida es en Ibagué).
          const dePaso = lista.find(o => o !== s &&
            mins(o.HoraRecogida) != null && mins(o.HoraLlegada) != null &&
            mins(o.HoraRecogida) < r && r < mins(o.HoraLlegada) &&
            normalizar(o.CiudadOrigen) !== normalizar(s.CiudadOrigen) &&
            normalizar(o.CiudadDestino) !== normalizar(s.CiudadOrigen) &&
            esRecogidaEnCorredorValida(o.CiudadOrigen, o.CiudadDestino, s.CiudadOrigen, s.CiudadDestino));

          // Lectura 2: el móvil ya había terminado en este mismo pueblo, o sea estaba
          // libre aquí y la salida es normal. Solo vale si ESE servicio es el último que
          // el móvil cerró antes de esta recogida. Si después hizo otro recorrido, el móvil
          // ya no está en ese pueblo y la lectura es imposible: en el móvil 0771 dejó a
          // Parra en Espinal a las 11:45, pero a las 14:00 volvió a pasar por Espinal por
          // el regreso de Saldaña, no porque se hubiera quedado allí desde la mañana.
          let finPosicion = -1;
          lista.forEach((o, j) => {
            const f = finesABordo[j];
            if (f && f[1] <= r && f[1] > finPosicion) finPosicion = f[1];
          });
          const yaLibre = finPosicion < 0 ? undefined :
            lista.find((o, j) => j !== idxS && finesABordo[j] &&
              finesABordo[j][1] === finPosicion &&
              normalizar(o.CiudadDestino) === normalizar(s.CiudadOrigen));

          // El móvil solo está LIBRE en un pueblo si a esa hora no le queda ningún
          // pasajero a bordo de otro servicio. Si aún lleva a alguien, la recogida es de
          // paso dentro de ese mismo recorrido: no son dos lecturas alternativas, es una
          // sola. Móvil 0771/0721: sale de Ibagué con dos pasajeros (uno a Espinal, otro a
          // Saldaña), en Espinal baja al primero y sube uno que va a Purificación, sigue a
          // Saldaña y termina en Purificación. Siempre viajó con dos; el punto final del
          // recorrido se extendió, no se abrió una segunda interpretación.
          const aBordoEnR = lista.some((o, k) => k !== idxS && finesABordo[k] &&
            finesABordo[k][0] < r && r < finesABordo[k][1]);

          if (dePaso && yaLibre && !aBordoEnR) confusos.push({ s, dePaso, yaLibre, finLibre: finPosicion });
        });

        if (confusos.length > 0) {
          hallazgosGlobales.push({
            categoria: 'CASO_ESPECIAL',
            tipo: 'CASO ESPECIAL: Trayecto confuso, revisar',
            vehiculo: vehId,
            fecha: formatearFecha(primerServicio.Fecha),
            detalle: `Regla: hay dos formas de leer el mismo recorrido y las dos cumplen. ` + confusos.map(c =>
              `<b>${c.s.Paciente}</b> (${c.s.HoraRecogida} en ${c.s.CiudadOrigen}) puede ser recogida de paso del servicio de <b>${c.dePaso.Paciente}</b> (${c.dePaso.CiudadOrigen}, en ruta hasta ~${c.dePaso.HoraLlegada}), o bien una salida normal porque el móvil ya lo había dejado a <b>${c.yaLibre.Paciente}</b> en ${c.yaLibre.CiudadDestino} a las ~${String(Math.floor(c.finLibre / 60)).padStart(2, '0')}:${String(c.finLibre % 60).padStart(2, '0')} (momento en que lo bajó, no la hora de llegada que trae la hoja).`
            ).join(' ') + ` Revisar el móvil ${vehId} a mano.`
          });
        }
      });

      document.getElementById('kpiServicios').textContent = servicios.length;
      // "Servicios revisados" ya no es el total de la hoja: es el total menos los Cancelados.
      // Si la hoja no tiene cómo saber el estado, se dice en el propio KPI en vez de mostrar 0,
      // que se leería como "no hubo ninguno".
      document.getElementById('kpiCancelados').textContent = canceladosExcluidos.traeColumna
        ? canceladosExcluidos.cantidad : '—';
      document.getElementById('kpiCanceladosTitulo').textContent = canceladosExcluidos.traeColumna
        ? 'Cancelados / Anulados excluidos' : 'Sin columna Estado: no se excluyó ninguno';
      // Con la hoja "carros" este KPI siempre mostró el tamaño de la flota. El archivo
      // de Traslados no trae flota, y ahí lo único que se puede contar son los móviles
      // que sí tienen servicios.
      document.getElementById('kpiVehiculos').textContent = hayFlota
        ? Object.keys(mapaFlota).length
        : movilesConServicios.size;
      document.getElementById('kpiUsuariosCompartidos').textContent = conteoUsuariosCompartidos;
      document.getElementById('kpiExclusivosCompartidos').textContent = conteoExclusivosCompartidos;
      document.getElementById('kpiInconsistenciasZona').textContent = conteoInconsistenciasZona;
      document.getElementById('kpiConflictos').textContent = conteoConflictos;
      document.getElementById('kpiVacio').textContent = conteoVacio;
      document.getElementById('kpiSinFlota').textContent = conteoSinFlota;

      // Sin hoja de flota no hay zona que validar ni móvil que esté "sin registrar", así
      // que esos dos filtros se ocultan en vez de mostrar un reporte vacío.
      const sinFlotaFiltro = !hayFlota;
      document.getElementById('opFiltroZona').style.display = sinFlotaFiltro ? 'none' : '';
      document.getElementById('opFiltroSinFlota').style.display = sinFlotaFiltro ? 'none' : '';
      const selectTipo = document.getElementById('filtroTipo');
      if (sinFlotaFiltro && ['ZONA_INCOMPATIBLE', 'SIN_FLOTA'].includes(selectTipo.value)) {
        selectTipo.value = 'TODOS';
      }

      hallazgosGlobales.sort((a, b) => {
        const porMovil = compararMoviles(a.vehiculo, b.vehiculo);
        if (porMovil !== 0) return porMovil;
        const fa = claveFecha(a.fecha), fb = claveFecha(b.fecha);
        if (fa != null && fb != null && fa !== fb) return fa - fb;
        return 0;
      });

      renderizarTabla(hallazgosGlobales);
      renderizarResumenMoviles();
    }

    function renderizarResumenMoviles() {
      const contenedor = document.getElementById('listaMoviles');
      contenedor.innerHTML = '';

      const porMovil = {};
      hallazgosGlobales.forEach(item => {
        const p = porMovil[item.vehiculo] || (porMovil[item.vehiculo] = { critico: 0, alerta: 0, vacio: 0, especial: 0 });
        if (item.categoria === 'CRITICO') p.critico++;
        else if (item.categoria === 'ADVERTENCIA') p.vacio++;
        else if (item.categoria === 'CASO_ESPECIAL') p.especial++;
        else p.alerta++;
      });

      const moviles = Object.entries(porMovil).sort((a, b) => compararMoviles(a[0], b[0]));

      if (moviles.length === 0) {
        contenedor.innerHTML = '<span style="font-size: 0.85rem; color: #94a3b8; font-style: italic;">No se encontraron inconsistencias en las asignaciones.</span>';
        return;
      }

      moviles.forEach(entrada => {
        const veh = entrada[0];
        const p = entrada[1];
        const partes = [];
        if (p.critico) partes.push(p.critico + ' conflicto' + (p.critico > 1 ? 's' : ''));
        if (p.alerta) partes.push(p.alerta + ' alerta' + (p.alerta > 1 ? 's' : ''));
        if (p.vacio) partes.push(p.vacio + ' tramo vac' + (p.vacio > 1 ? 'íos' : 'ío'));
        if (p.especial) partes.push(p.especial + ' caso especial');

        const chip = document.createElement('div');
        chip.className = 'movil-chip ' + (p.critico ? 'grave' : (p.alerta ? 'medio' : 'leve'));
        chip.dataset.movil = veh;
        chip.innerHTML = `<div class="movil-id">${veh}</div><div class="movil-cuentas">${partes.join(' · ')}</div>`;
        chip.onclick = () => seleccionarMovil(veh);
        contenedor.appendChild(chip);
      });

      marcarChipActivo();
    }

    function seleccionarMovil(veh) {
      const input = document.getElementById('filtroVehiculo');
      input.value = input.value.trim() === veh ? '' : veh;
      filtrarResultados();
      document.querySelector('.panel:last-of-type').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function verTodosMoviles() {
      document.getElementById('filtroVehiculo').value = '';
      filtrarResultados();
    }

    function marcarChipActivo() {
      const activo = document.getElementById('filtroVehiculo').value.trim().toLowerCase();
      document.querySelectorAll('.movil-chip').forEach(chip => {
        chip.classList.toggle('activa', chip.dataset.movil.toLowerCase() === activo);
      });
      document.getElementById('btnVerTodos').style.display = activo ? 'inline-block' : 'none';
    }

    function renderizarTabla(datos) {
      const tbody = document.getElementById('tbodyHallazgos');
      tbody.innerHTML = '';

      if (datos.length === 0) {
        tbody.innerHTML = '<tr><td colspan="4" class="empty-state">No se encontraron hallazgos o conflictos.</td></tr>';
        return;
      }

      datos.forEach(item => {
        const tr = document.createElement('tr');

        let badgeClass = 'info';
        if (item.categoria === 'CRITICO') badgeClass = 'critico';
        if (item.categoria === 'EXCLUSIVO_COMPARTIDO') badgeClass = 'exclusivo-compartido';
        if (item.categoria === 'ZONA_INCOMPATIBLE') badgeClass = 'zona-incompatible';
        if (item.categoria === 'ADVERTENCIA') badgeClass = 'advertencia';
        if (item.categoria === 'CASO_ESPECIAL') badgeClass = 'caso-especial';
        if (item.categoria === 'SIN_FLOTA') badgeClass = 'sin-flota';

        tr.innerHTML = `
          <td><span class="badge ${badgeClass}">${item.tipo}</span></td>
          <td><b>${item.vehiculo}</b></td>
          <td>${item.fecha}</td>
          <td>${item.detalle}</td>
        `;
        tbody.appendChild(tr);
      });
    }

    function filtrarResultados() {
      const tipo = document.getElementById('filtroTipo').value;
      const veh = document.getElementById('filtroVehiculo').value.trim().toLowerCase();

      const filtrados = hallazgosGlobales.filter(item => {
        const cumpleTipo = (tipo === 'TODOS') || (item.categoria === tipo);
        const cumpleVeh = !veh || item.vehiculo.toLowerCase().includes(veh);
        return cumpleTipo && cumpleVeh;
      });

      renderizarTabla(filtrados);
      marcarChipActivo();
    }
  </script>
</body>
